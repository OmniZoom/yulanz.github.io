---
import { profile, type Locale } from "../data/site";
interface Props { locale: Locale; mode?: "home" | "case"; active?: string; }
const { locale, mode = "home", active = "overview" } = Astro.props;
const copy = profile[locale];
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
const otherHref = locale === "en"
  ? asset(mode === "home" ? "/zh/" : "/zh/projects/enterprise-engineering-copilot/")
  : asset(mode === "home" ? "/" : "/projects/enterprise-engineering-copilot/");
const homeHref = asset(locale === "en" ? "/" : "/zh/");
const projectHref = asset(locale === "en" ? "/projects/enterprise-engineering-copilot/" : "/zh/projects/enterprise-engineering-copilot/");
const caseNav = locale === "en"
  ? [["problem","01 · Problem"],["research","02 · Research"],["product","03 · Product"],["prd","04 · PRD"],["feasibility","05 · Feasibility"],["workflow","06 · Workflow"],["engineering","07 · Engineering"],["evaluation","08 · Evaluation"],["iteration","09 · Iteration"],["cost","10 · Cost"],["value","11 · Value & Roadmap"]]
  : [["problem","01 · 问题"],["research","02 · 研究边界"],["product","03 · 产品"],["prd","04 · PRD"],["feasibility","05 · 可行性"],["workflow","06 · Workflow"],["engineering","07 · 工程"],["evaluation","08 · Evaluation"],["iteration","09 · 迭代"],["cost","10 · 成本"],["value","11 · 价值与路线图"]];
---
<aside class="sidebar">
  <div class="identity">
    <a class="portrait-link" href={homeHref} aria-label={locale === "en" ? "Yulan Zeng — home" : "曾钰岚—首页"}>
      <img class="portrait" src={asset("/images/profile/self.jpg")} alt={locale === "en" ? "Portrait of Yulan Zeng" : "曾钰岚的个人照片"} />
    </a>
    <div class="identity-copy"><a class="name" href={homeHref}>{copy.name}</a><p class="alternate-name">{copy.chineseName}</p><p class="role">{copy.role}</p></div>
  </div>
  <nav class="side-tabs" aria-label={mode === "home" ? (locale === "en" ? "Personal website sections" : "个人网站栏目") : "Case study sections"} role={mode === "home" ? "tablist" : undefined}>
    {mode === "home" ? copy.nav.map(([id, label]) => (
      <div class:list={["nav-group", { "project-nav": id === "projects" }]}>
        <button class:list={["side-tab", { active: id === active }]} type="button" role="tab" data-tab-target={id} aria-controls={`panel-${id}`} aria-selected={id === active}>{label}</button>
        {id === "projects" && <div class="project-subnav"><a href={projectHref}>{locale === "en" ? "Enterprise Engineering Copilot" : "企业工程 Copilot"}</a></div>}
      </div>
    )) : caseNav.map(([id, label]) => <a class="side-tab" href={`#${id}`}>{label}</a>)}
  </nav>
  <div class="sidebar-links">
    {mode === "case" && <a href={`${homeHref}#projects`}>← {locale === "en" ? "Back to projects" : "返回项目页面"}</a>}
    <a href="https://github.com/abigailmounind" rel="me">GitHub ↗</a>
    {copy.resumeHref && <a href={copy.resumeHref} download>{copy.resume} ↓</a>}
    <a href={copy.contactHref}>{copy.contact} ↗</a>
    <a href={otherHref} lang={locale === "en" ? "zh-CN" : "en"}>{copy.language}</a>
  </div>
</aside>
