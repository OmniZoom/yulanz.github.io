---
import type { Locale } from "../data/site";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === "zh";
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
const scenarioRows = zh ? [
  ["工程知识问答", "在授权范围内快速获得可信答案", "带行内引用和可展开原文的 grounded answer"],
  ["技术方案比较", "理解两个目标的关键差异与依据", "分别检索、保留来源归属的结构化比较"],
  ["故障排查", "依据既有流程判断检查项与下一步", "Runbook 引导、保留安全前置条件的只读诊断"],
] : [
  ["Engineering Q&A", "Reach a trustworthy answer inside an authorized scope", "Grounded answer with inline citations and expandable excerpts"],
  ["Technical comparison", "Understand differences between two explicit targets", "Independent retrieval with source ownership preserved"],
  ["Troubleshooting", "Use documented procedures to decide the next safe step", "Read-only Runbook guidance with safety prerequisites intact"],
];
const aiRows = zh ? [
  ["Retrieval", "在授权范围内找到并排序任务证据", "Recall@1/3/5 · MRR · nDCG@5"],
  ["Grounded answer", "仅根据有效证据组织答案", "Citation resolution · human semantic review"],
  ["Compare", "分别检索两个目标并保持来源归属", "Citation ownership · typed terminal outcome"],
  ["Troubleshoot", "保留 Runbook 的必需步骤与安全边界", "Required-step coverage · read-only behavior"],
  ["Refusal & runtime", "证据不足或依赖失败时安全终止", "Refusal accuracy · provider/runtime failure"],
] : [
  ["Retrieval", "Find and rank task evidence inside the authorized scope", "Recall@1/3/5 · MRR · nDCG@5"],
  ["Grounded answer", "Synthesize only from valid evidence", "Citation resolution · human semantic review"],
  ["Compare", "Retrieve each target independently and preserve provenance", "Citation ownership · typed terminal outcome"],
  ["Troubleshoot", "Preserve required Runbook steps and safety boundaries", "Required-step coverage · read-only behavior"],
  ["Refusal & runtime", "Stop safely on insufficient evidence or dependency failure", "Refusal accuracy · provider/runtime failure"],
];
const flow = zh ? ["选择知识范围", "选择任务模式", "构造 typed task", "检索授权证据", "Evidence Gate", "生成或安全终止", "检查引用"] : ["Select knowledge scope", "Choose task mode", "Build typed task", "Retrieve authorized evidence", "Evidence gate", "Generate or stop safely", "Review citations"];
---

<div class="prd-story">
  <section class="prd-framework" aria-label={zh ? "产品需求框架" : "Product requirement framework"}>
    <p class="prd-kicker">A · {zh ? "产品需求框架" : "Product Requirement Framework"}</p>
    <div class="requirement-chain">
      <div><span>{zh ? "产品目标" : "Product goal"}</span><strong>{zh ? "缩短从问题到可信行动的时间" : "Reduce time from question to trusted action"}</strong></div><i>→</i>
      <div><span>{zh ? "用户需要" : "User need"}</span><strong>{zh ? "答案可执行、可验证、可追溯" : "Actionable, verifiable, traceable answers"}</strong></div><i>→</i>
      <div><span>{zh ? "产品能力" : "Product capability"}</span><strong>{zh ? "授权检索、证据生成与有边界流程" : "Scoped retrieval, grounded generation, bounded workflows"}</strong></div><i>→</i>
      <div><span>{zh ? "成功定义" : "Success definition"}</span><strong>{zh ? "任务更快完成，关键结论都有依据" : "Faster task completion with evidence for key claims"}</strong></div>
    </div>
  </section>

  <section class="prd-table-section">
    <p class="prd-kicker">B · {zh ? "用户场景 → 需求映射" : "User Scenario → Requirement Mapping"}</p>
    <div class="prd-table-wrap"><table><thead><tr><th>{zh ? "用户场景" : "User scenario"}</th><th>{zh ? "用户需要" : "User need"}</th><th>{zh ? "产品需求" : "Product requirement"}</th></tr></thead><tbody>{scenarioRows.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody></table></div>
  </section>

  <section class="prd-table-section">
    <p class="prd-kicker">C · {zh ? "AI 功能验收定义" : "AI Feature Requirements"}</p>
    <p class="prd-caption">{zh ? "每项能力同时定义预期行为与可观察的验收信号。" : "Every capability pairs expected behavior with an observable acceptance signal."}</p>
    <div class="prd-table-wrap"><table><thead><tr><th>{zh ? "能力" : "Capability"}</th><th>{zh ? "需求" : "Requirement"}</th><th>{zh ? "验收标准" : "Acceptance criteria"}</th></tr></thead><tbody>{aiRows.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody></table></div>
  </section>

  <section class="prd-flow-section">
    <p class="prd-kicker">D · {zh ? "用户流程" : "User Flow"}</p>
    <div class="prd-user-flow">{flow.map((step, i) => <><div><span>{String(i + 1).padStart(2,"0")}</span><strong>{step}</strong></div>{i < flow.length - 1 && <i>→</i>}</>)}</div>
    <p class="flow-note">{zh ? "任务模式由用户显式选择，而不是交给开放式 Agent 猜测。证据不足时，Evidence Gate 转向明确拒答；provider 或 runtime 失败则返回 typed failure。" : "The user selects the task mode explicitly instead of leaving it to an open-ended agent. Insufficient evidence routes to refusal; provider or runtime failures remain typed failures."}</p>
  </section>

  <section class="prd-prototypes">
    <p class="prd-kicker">E · {zh ? "核心产品原型" : "Core Product Prototype"}</p>
    <p class="prd-caption">{zh ? "从知识进入系统，到三个核心能力，再到共享证据与拒答机制。" : "From knowledge entering the system, through three core capabilities, to the shared evidence and refusal layer."}</p>
    <figure class="prototype-diagram">
      <img src={asset("/images/enterprise-agent/product-prototype.png")} alt={zh ? "企业工程知识进入可信 AI 工作流：系统、三项核心能力与共享信任层" : "Enterprise engineering knowledge flowing through three core capabilities and a shared trust layer"} loading="lazy" width="1672" height="941" />
      <figcaption class="prototype-legend" aria-label={zh ? "原型图图例" : "Prototype legend"}>
        <span><i class="legend-input"></i>{zh ? "用户输入与任务合同" : "User input and task contract"}</span>
        <span><i class="legend-behavior"></i>{zh ? "AI 与 Workflow 产品行为" : "AI and workflow behavior"}</span>
        <span><i class="legend-evidence"></i>{zh ? "可检查的证据反馈" : "Inspectable evidence feedback"}</span>
      </figcaption>
    </figure>
    <p class="prototype-note">{zh ? "虚线框表示同一受控系统中的三种任务工作流，不代表独立 Agent 或多 Agent 架构。" : "The dashed boundary contains three task workflows inside one controlled system; it does not represent independent agents or a multi-agent architecture."}</p>
  </section>

  <section class="prd-priority">
    <p class="prd-kicker">F · {zh ? "能力演进与决策证据" : "Capability Evolution and Decision Evidence"}</p>
    <div class="priority-line">
      <div><b>M1</b><strong>{zh ? "可信答案基础" : "Trusted-answer foundation"}</strong><p>{zh ? "知识摄取 · Grounded Q&A · Citation" : "Knowledge ingestion · Grounded Q&A · Citation"}</p></div>
      <div><b>M2</b><strong>{zh ? "检索质量" : "Retrieval quality"}</strong><p>Hybrid retrieval · Optional reranking</p></div>
      <div><b>M3–M4</b><strong>{zh ? "有边界的执行" : "Bounded execution"}</strong><p>Compare · Tools · Authorization · Runtime</p></div>
      <div><b>M5</b><strong>{zh ? "质量与交付闭环" : "Quality and delivery closure"}</strong><p>Troubleshooting · Evaluation · Deployment</p></div>
    </div>
  </section>

  <section class="prd-metrics">
    <p class="prd-kicker">G · {zh ? "成功指标体系" : "Success Metrics"}</p>
    <div class="metric-tree"><div class="tree-root">{zh ? "成功完成且有证据支持的工程任务" : "Successfully completed, evidence-supported engineering tasks"}</div><div class="tree-branches">
      <div><strong>{zh ? "检索" : "Retrieval"}</strong><span>Recall@K</span><span>MRR</span></div>
      <div><strong>{zh ? "答案" : "Answer"}</strong><span>Citation resolution</span><span>Human review</span></div>
      <div><strong>{zh ? "可靠性" : "Reliability"}</strong><span>Refusal accuracy</span><span>Typed failures</span></div>
      <div><strong>{zh ? "效率" : "Efficiency"}</strong><span>Latency · Token usage</span><span>Cost / completed task</span></div>
    </div></div>
  </section>

  <section class="prd-tradeoffs">
    <p class="prd-kicker">H · {zh ? "产品取舍" : "Product Trade-offs"}</p>
    <div><span>{zh ? "可靠性" : "Reliability"}</span><i>↔</i><span>{zh ? "自主性" : "Autonomy"}</span><p>{zh ? "优先选择可检查、可停止的工作流。" : "Prefer inspectable workflows that can stop safely."}</p></div>
    <div><span>{zh ? "答案质量" : "Answer quality"}</span><i>↔</i><span>{zh ? "响应延迟" : "Latency"}</span><p>{zh ? "Reranking 保持可选，只在收益值得时启用。" : "Keep reranking optional and enable it only when the gain earns the delay."}</p></div>
    <div><span>{zh ? "更多上下文" : "More context"}</span><i>↔</i><span>{zh ? "成本与噪声" : "Cost & noise"}</span><p>{zh ? "按任务限制证据预算，而不是无限扩展上下文。" : "Use task-specific evidence budgets instead of unbounded context."}</p></div>
  </section>
  <p class="prd-source">{zh ? "完整需求文档保留在项目仓库：" : "Full product requirements remain in the project repository: "}<a href="https://github.com/abigailmounind/enterprise-agent/blob/main/docs/PRD.md" target="_blank" rel="noreferrer">docs/PRD.md ↗</a></p>
</div>
