---
import Sidebar from "./Sidebar.astro";
import Icon from "./Icon.astro";
import Experience from "./Experience.astro";
import Research from "./Research.astro";
import Skills from "./Skills.astro";
import { overview, project, type Locale } from "../data/site";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = project[locale];
const overviewCopy = overview[locale];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const asset = (path: string) => `${base}${path.replace(/^\//, "")}`;
const caseHref = asset(locale === "en" ? "/projects/enterprise-engineering-copilot/" : "/zh/projects/enterprise-engineering-copilot/");
const videoHref = "https://www.bilibili.com/video/BV1vZb16wEEU/";
---
<div class="site-shell">
  <Sidebar locale={locale} />
  <main class="main-column">
    <section class="tab-panel active" id="panel-overview" role="tabpanel" data-tab-panel="overview">
      <header class="page-heading overview-heading">
        <div class="intro-copy">{overviewCopy.introduction.map((paragraph) => <p>{paragraph}</p>)}</div>
      </header>
      <section class="timeline-section" aria-labelledby="timeline-title">
        <p class="section-label" id="timeline-title">{overviewCopy.timelineLabel}</p>
        <div class="timeline">
          {overviewCopy.timeline.map((item, index) => <article class:list={["timeline-item", { reverse: index % 2 === 1 }]}>
            <div class="timeline-card">
              <time>{item.period}</time><h2>{item.organization}</h2><p class="timeline-role">{item.role}</p><p>{item.description}</p>
            </div>
            <span class="timeline-node" aria-hidden="true"></span>
          </article>)}
        </div>
      </section>
    </section>
    <section class="tab-panel" id="panel-projects" role="tabpanel" data-tab-panel="projects" hidden>
      <h1>{copy.title}</h1><p class="lede">{copy.summary}</p>
      <div class="paper-actions"><a href={caseHref}><Icon name="document" />{copy.actions.caseStudy}</a><a href="https://github.com/abigailmounind/enterprise-agent" target="_blank" rel="noreferrer"><Icon name="github" />{copy.actions.github}</a><a href={videoHref} target="_blank" rel="noreferrer"><Icon name="play" />{copy.actions.video}</a></div>
      <div class="project-visual"><img src={asset("/images/enterprise-agent/workspace.png")} alt={locale === "en" ? "Enterprise Engineering Copilot workspace" : "Enterprise Engineering Copilot 工作台"} /></div>
      <div class="metric-grid">{copy.outcomes.map(([value,label]) => <div><strong>{value}</strong><span>{label}</span></div>)}</div>
    </section>
    <section class="tab-panel" id="panel-experience" role="tabpanel" data-tab-panel="experience" hidden><Experience locale={locale} /></section>
    <section class="tab-panel" id="panel-research" role="tabpanel" data-tab-panel="research" hidden><Research locale={locale} /></section>
    <section class="tab-panel" id="panel-skills" role="tabpanel" data-tab-panel="skills" hidden><Skills locale={locale} /></section>
  </main>
</div>
<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tab-target]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-tab-panel]"));
  const select = (id: string, updateHash = true) => {
    tabs.forEach((tab) => { const selected = tab.dataset.tabTarget === id; tab.classList.toggle("active", selected); tab.setAttribute("aria-selected", String(selected)); tab.tabIndex = selected ? 0 : -1; });
    panels.forEach((panel) => { const selected = panel.dataset.tabPanel === id; panel.hidden = !selected; panel.classList.toggle("active", selected); });
    if (updateHash) history.replaceState(null, "", `#${id}`);
  };
  tabs.forEach((tab) => tab.addEventListener("click", () => select(tab.dataset.tabTarget ?? "overview")));
  tabs.forEach((tab, index) => tab.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowUp" && event.key !== "ArrowDown") return;
    event.preventDefault();
    const offset = event.key === "ArrowDown" ? 1 : -1;
    const next = tabs[(index + offset + tabs.length) % tabs.length];
    next?.focus();
    select(next?.dataset.tabTarget ?? "overview");
  }));
  const initial = location.hash.slice(1); if (tabs.some((tab) => tab.dataset.tabTarget === initial)) select(initial, false);
</script>
