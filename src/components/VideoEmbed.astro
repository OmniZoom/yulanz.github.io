---
import Icon from "./Icon.astro";
interface Props { title: string; providerUrl?: string; poster?: string; caption: string; }
const { title, providerUrl, poster, caption } = Astro.props;
---
{providerUrl && <figure class="video-embed">
  <a class="video-poster" href={providerUrl} target="_blank" rel="noreferrer" aria-label={`${caption}: ${title}`}>
    {poster && <img src={poster} alt="" />}
    <span><Icon name="play" size={24} />{caption}</span>
  </a>
  <figcaption>{title}</figcaption>
</figure>}
